<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <service android:name=".companion.CompanionMediaFixtureService"
            android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".companion.CompanionReplyFixtureActivity" android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Exported so adb can post the fixture; debug builds only. -->
        <receiver android:name=".companion.CompanionReplyFixtureReceiver" android:exported="true" />
    </application>
    <instrumentation android:name="dev.zswatch.app.companion.CompanionTransferProbe"
        android:targetPackage="com.zswatch.app" android:label="ZSWatch transfer probe" />
</manifest>
